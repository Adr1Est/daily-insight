// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  schemas = ["daily_insight"]
}

model Insight {
  id        Int      @id @default(autoincrement())
  game      String
  platform  String
  /// Año del hecho (el fallo, el secreto, la versión…). Se llama bugYear por historia.
  bugYear   Int
  /// Tipo de curiosidad: bug | secreto | desarrollo | descartado | localizacion (lib/insights/kinds.ts).
  kind      String   @default("bug")
  data      String 
  day       Int
  month     String
  year      Int
  createdAt DateTime @default(now())
  /// Me gusta − no me gusta. Contador de Vote, actualizado en la misma transacción (lib/votes.ts).
  score     Int      @default(0)
  /// Entrada del calendario (lib/insights/calendar.ts) que motivó la curiosidad ese día, si la hubo.
  /// Se copia al generar para que el archivo no cambie si luego se edita el calendario.
  releaseGame     String?
  releasePlatform String?
  /// Año de salida: si coincide con `year` es un estreno; si no, un aniversario.
  releaseYear     Int?
  votes     Vote[]

  @@schema("daily_insight")
}

/// Un voto por bug y navegador (cookie anónima `daily-bug-voter`).
model Vote {
  insightId Int
  voterId   String   @db.Uuid
  /// 1 = me gusta, -1 = no me gusta (CHECK en la migración). Quitar el voto borra la fila.
  value     Int      @db.SmallInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  insight   Insight  @relation(fields: [insightId], references: [id], onDelete: Cascade)

  @@id([insightId, voterId])
  @@schema("daily_insight")
}
